# Environment variables are for local reference only.
# Angular uses fileReplacements for production builds:
#   environment.ts        → local dev (http://localhost:8080/api)
#   environment.prod.ts   → production build (api.cryptowatch.app/api)
#
# To change the API URL, edit environment.prod.ts before deploying.

NG_APP_API_URL=http://localhost:8080/api
